# ---------------------------------------------------------------------------
# Copy this file to .env and set OPENROUTER_API_KEY. Everything else already
# has a working default — the app runs without this file at all, it just cannot
# generate answers.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# --- Model provider ---------------------------------------------------------
# The only value with no usable default. Get a free key at
# https://openrouter.ai/keys — no card required for the `:free` models.
# Without it the app still starts: conversations, history and persistence all
# work, and sending a message returns a typed error explaining what is missing.
OPENROUTER_API_KEY=

# Tried in order, comma separated. Free models are rate limited *per model*,
# so when the first returns 429 the next usually answers immediately — and a
# model that has been retired is skipped rather than breaking the app.
# A single value is fine. Current list: https://openrouter.ai/models?q=free
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.0-tiny:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Conversation behaviour --------------------------------------------------
# How many previous messages are sent with each request. A window by message
# count, not by tokens.
# How long to wait for a model's first token before giving up on it and trying
# the next. Short on purpose: nothing has reached the browser yet, so a model
# that has gone quiet costs only this much before another one is tried.
FIRST_TOKEN_TIMEOUT_SECONDS=20

HISTORY_LIMIT=20

# One extra provider call after the first turn, to replace the truncated first
# message with a real title. Set to false to halve what a first turn costs.
GENERATE_TITLES=true

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
MONGO_DB=chatbot

# --- Host ports ---------------------------------------------------------------
# WEB_PORT is the one you open in a browser. The other two are published for
# convenience (Swagger UI, a mongosh session) and are not needed to use the app.
WEB_PORT=8080
API_PORT=8000
MONGO_PORT=27017
